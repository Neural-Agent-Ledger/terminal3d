shapes =
# A) RampZ PosX staircase (y=3, walking east)
4 3 1 rampz posx
5 3 2 rampz posx
6 3 3 rampz posx
7 3 4 rampz posx
# B) RampZ NegX staircase (y=11, walking west)
16 11 1 rampz negx
15 11 2 rampz negx
14 11 3 rampz negx
13 11 4 rampz negx
# C) RampZ PosY staircase (x=19, walking south)
19 3 1 rampz posy
19 4 2 rampz posy
19 5 3 rampz posy
19 6 4 rampz posy
# D) RampZ NegY staircase (x=2, walking north)
2 11 1 rampz negy
2 10 2 rampz negy
2 9 3 rampz negy
2 8 4 rampz negy
# E) Spiral half-turn (center=(10,7), PosX side then PosY side)
9 6 0 rampz posx
10 6 1 rampz posx
11 6 2 rampz posy
11 7 3 rampz posy
# F-I) WedgeXY corner reference geometry (z=1)
9 8 1 wedgexy ne
12 8 1 wedgexy nw
9 10 1 wedgexy se
12 10 1 wedgexy sw

[node a]
pos         = 5 7 2
glyph       = A
is_input    = yes

[node b]
pos         = 10 7 5
glyph       = B
is_output   = yes
threshold   = 1

[pipe a->b]
state       = ON
path        = (5,7,2) (10,7,5)

[part block]
size        = 1 1 1
mask        =
#
color       = #80DDFF

[emit b=1]
parts       = block

[inputs]
a           = 1

[pedestal]
center      = 9 7 4
volume      = 1 1 1

[door]
pos         = 15 7 4
target_parts = b

[player]
spawn       = 5 7 1
facing      = +x
