# terminal3d example level — levels/STAIRS-showcase.lvl
#
# STAIRS SHOWCASE — two-storey arena demonstrating every staircase/ramp variant.
#
# storey_height = 4  (4 ramp treads per storey, same as levels/20-stairs-straight.lvl).
# Room: 22 × 16 × 9   (x=0..21, y=0..15, z=0..8).
#   Floor 0:  z=0 (slab)            z=1..3 (gameplay space)
#   Floor 1:  z=4 (slab)            z=5..7 (gameplay space)
#   Ceiling:  z=8
#
# ── Staircase inventory ────────────────────────────────────────────────────────
#
# A) RampZ PosX  — corridor y=3, walking east (+x)
#    base=(3,3,0)  treads (4,3,1)(5,3,2)(6,3,3)(7,3,4)  landing (8,3,4)
#    Shaft at z=4: x=4,5,6 y=3 = Empty '.'
#
# B) RampZ NegX  — corridor y=11, walking west (-x)
#    base=(17,11,0)  treads (16,11,1)(15,11,2)(14,11,3)(13,11,4)  landing (12,11,4)
#    Shaft at z=4: x=14,15,16 y=11 = Empty '.'
#
# C) RampZ PosY  — corridor x=19, walking south (+y)
#    base=(19,2,0)  treads (19,3,1)(19,4,2)(19,5,3)(19,6,4)  landing (19,7,4)
#    Shaft at z=4: y=3,4,5 x=19 = Empty '.'
#
# D) RampZ NegY  — corridor x=2, walking north (-y)
#    base=(2,12,0)  treads (2,11,1)(2,10,2)(2,9,3)(2,8,4)  landing (2,7,4)
#    Shaft at z=4: y=9,10,11 x=2 = Empty '.'
#
# E) SPIRAL (half-turn, 4 treads) — center=(10,7), radius=1, sides PosX then PosY
#    Column: (10,7) solid z=0..4.
#    Tread sequence matching spiral_staircase() first 2 sides of radius-1:
#      Side 0 (PosX, cursor starts (9,6)):
#        (9,6,0)  rampz posx   ← in floor-slab z=0
#        (10,6,1) rampz posx
#        corner at (11,6,2) → immediately overwritten by side-1
#      Side 1 (PosY, cursor at (11,6)):
#        (11,6,2) rampz posy
#        (11,7,3) rampz posy
#        corner landing (11,8,4) solid
#    Shaft at z=4: (10,6)(11,6)(11,7) = Empty '.'
#
# ── Wedge reference geometry (NOT climbable — vertical 45° diagonal corner walls)
# F) WedgeXY NE  at (9,8,1)
# G) WedgeXY NW  at (12,8,1)
# H) WedgeXY SE  at (9,10,1)
# I) WedgeXY SW  at (12,10,1)
#
# ── Player spawn & goal ───────────────────────────────────────────────────────
# Spawn: (5,7,1) facing +x — floor 0, central area, looking east toward spiral.
# Win node B at (10,7,5) on floor 1.
#
# Render: cargo run -p re_imgqa -- levels/STAIRS-showcase.lvl

[meta]
name        = STAIRS-showcase
title       = Staircase Showcase — All Variants

[room]
size        = 22 16 9
ambient     = solid
storey_height = 4

[material walls]
fg          = #9AAABB
bg          = #10141C
recipe      = brick aspect=2.0 mortar_w=0.14 grain=0.18
surface     = wall_solid

[material ground]
preset      = metal
surface     = floor

[material roof]
preset      = void
surface     = ceiling

# ── Dense [cells] grid ────────────────────────────────────────────────────────
# 22 cols (x=0..21) × 16 rows (y=0..15) × 9 z-layers.
# '#' = WallSolid   '.' = Empty   '_' = Floor   '^' = Ceiling
[cells]
size        = 22 16 9

