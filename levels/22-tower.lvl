# Staircase geometry — ramp shapes.
# Staircase A (floor 0 → floor 1, corridor y=3, walking +x):
#   straight_staircase(base=(3,3,0), dir=PosX, storey_height=4)
# Staircase B (floor 1 → floor 2, corridor y=8, walking +x):
#   straight_staircase(base=(10,8,4), dir=PosX, storey_height=4)
shapes =
4 3 1 rampz posx
5 3 2 rampz posx
6 3 3 rampz posx
7 3 4 rampz posx
11 8 5 rampz posx
12 8 6 rampz posx
13 8 7 rampz posx
14 8 8 rampz posx

# ── Puzzle: win objective on floor 2 ─────────────────────────────────────────
# Node A (input) on floor 2; node B (output) on floor 2.
# The player must climb BOTH staircases to interact with the switch and win.

[node a]
pos         = 3 6 9
glyph       = A
is_input    = yes

[node b]
pos         = 13 6 9
glyph       = B
is_output   = yes
threshold   = 1

[pipe a->b]
state       = ON
path        = (3,6,9) (13,6,9)

[part block]
size        = 1 1 1
mask        =
#
color       = #A0E0FF

[emit b=1]
parts       = block

[inputs]
a           = 1

[pedestal]
center      = 12 6 8
volume      = 1 1 1

[door]
pos         = 15 6 8
target_parts = b

# Spawn on floor 0, facing +x (east, toward the straight staircase).
[player]
spawn       = 2 3 1
facing      = +x
