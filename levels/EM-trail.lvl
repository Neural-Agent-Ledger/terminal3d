# terminal3d example level — levels/EM-trail.lvl
#
# PARTICLE-EMITTER SHOWCASE (trails + direction glyphs, sparks bounce) — NOT a
# campaign puzzle. One emitter combining both:
# sparks fired in a jet, pulled down by gravity, that BOUNCE off the emitter's
# own origin height with damped restitution (`bounce`) and drag a fading
# directional ghost trail (`trail ... dir_glyphs=on`) instead of a bare point.

[meta]
name        = EM-trail
title       = Bounce & Trail

[room]
size        = 10 10 4
ambient     = solid

[material floor_grid]
fg          = #2A8CC0
bg          = #06121A
glyph       = .
recipe      = grain scale=2.0 speck=0.35 tile_eps=0.08
surface     = floor

[material wall_panel]
fg          = #6E7A88
bg          = #0A0E14
glyph       = #
recipe      = grain scale=1.5 speck=0.2 tile_eps=0.06
surface     = wall_solid

[node in_a]
pos          = 2,2,2
glyph        = A
is_input     = yes

[node out]
pos          = 7,2,2
glyph        = O
is_output    = yes

[pipe in_a->out]
state        = OFF
path         = (2,2,2) (7,2,2)

[pedestal]
center       = 7 2 1
volume       = 1 1 1

[door]
pos          = 9 5 1

[player]
spawn        = 5 8 1
facing       = -y

# ── BOUNCE TRAIL — bounce (W5) + trail w/ direction glyphs (W4) ──────────────
[emitter bounce_trail]
origin_world    = 3.0 5.0 2.0
colors          = 0xFFFFFF 0xFFC060 0x904000
color_mode      = RampOverAge
family          = anim_arc
bold            = ByProximity
direction       = 0.7 0.3 0.4
spread_deg      = 25.0
speed           = 2.6
speed_spread    = 0.5
rate            = 12.0
lifetime        = 2.5
lifetime_spread = 0.3
accel           = 0.0 0.0 -3.5
bounce          = 0.5
trail           = 5 fade=0.55 dir_glyphs=on
max_particles   = 128
seed            = 9301
blend           = Opaque
