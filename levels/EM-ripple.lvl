# terminal3d example level — levels/EM-ripple.lvl
#
# PARTICLE-EMITTER SHOWCASE (ripples on floor/water) — NOT a campaign puzzle.
# `motion = ripple`: an expanding ring on the emitter's horizontal plane,
# `radius(age) = speed * age`, each particle's angle around the ring fixed at
# birth so a steady spawn rate scatters points all the way around the circle
# — several concentric rings coexist from ONE emitter (a dripping-tap read),
# and the ring correctly occludes behind/against geometry because it reuses
# the ordinary world-projection splat path.
#
# An underline "hem" on the leading edge is authored but not yet visible in
# the composited frame — see docs/EMITTERS.md "Ripples: hem style is
# authored, not yet visible" and `re_render::ripple` module docs for the full
# trace (a composite-layer limitation). The ring reads today via its
# glyph+colour fade.

[meta]
name        = EM-ripple
title       = Ripple Rings

[room]
size        = 10 10 4
ambient     = solid

[material floor_grid]
fg          = #2A8CC0
bg          = #06121A
glyph       = .
recipe      = grain scale=2.0 speck=0.35 tile_eps=0.08
surface     = floor

[material wall_panel]
fg          = #6E7A88
bg          = #0A0E14
glyph       = #
recipe      = grain scale=1.5 speck=0.2 tile_eps=0.06
surface     = wall_solid

[node in_a]
pos          = 2,2,2
glyph        = A
is_input     = yes

[node out]
pos          = 7,2,2
glyph        = O
is_output    = yes

[pipe in_a->out]
state        = OFF
path         = (2,2,2) (7,2,2)

[pedestal]
center       = 7 2 1
volume       = 1 1 1

[door]
pos          = 9 5 1

[player]
spawn        = 5 8 1
facing       = -y

# ── RIPPLE RINGS — motion = ripple (W10) ──────────────────────────────────────
[emitter water_ripple]
origin_world    = 5.0 5.0 0.05
colors          = 0xC0E8FF 0x60A0D0 0x204860
color_mode      = RampOverAge
family          = haze_wave
bold            = Off
motion          = ripple speed=1.4
rate            = 6.0
lifetime        = 3.0
lifetime_spread = 0.0
max_particles   = 220
seed            = 9501
blend           = KeepBg
