# terminal3d example level — levels/21-stairs-spiral.lvl
#
# DEMO · SPIRAL STAIRCASE — a 2-storey atrium with a 3×3 spiral staircase
# around a solid central column (radius=1, 1 turn), climbing from floor 0
# to floor 1 (storey_height = 8).
#
# storey_height = 8  (one spiral turn = 8 cells = 1 storey).
#
# Spiral center: (6,6,0), radius=1, turns=1 → rises 8*1*1 = 8 cells.
# Generated by spiral_staircase(center=(6,6,0), radius=1, turns=1, storey_height=8).
#
# Cell positions (all WallSolid '#'):
#   Column:   (6,6,z)  for z=0..8     (9 cells, single centre column)
#   z=0:  (5,5,0) rampz posx           <- tread 1 (side 0)
#   z=1:  (6,5,1) rampz posx           <- tread 2 (side 0)
#   z=2:  (7,5,2) rampz posy           <- tread 3 (side 1 overwrites corner)
#   z=3:  (7,6,3) rampz posy           <- tread 4 (side 1)
#   z=4:  (7,7,4) rampz negx           <- tread 5 (side 2 overwrites corner)
#   z=5:  (6,7,5) rampz negx           <- tread 6 (side 2)
#   z=6:  (5,7,6) rampz negy           <- tread 7 (side 3 overwrites corner)
#   z=7:  (5,6,7) rampz negy           <- tread 8 (side 3)
#   z=8:  (5,5,8) solid (landing)      <- turn-1 final corner / top landing
#
# Spawn on floor 0: (2,6,1) facing +x (walks east toward the spiral base).
# Goal on floor 1: interact the switch, win on upper floor.
#
# Render (floor-0 view):
#   cargo run -p re_imgqa -- levels/21-stairs-spiral.lvl
# Interactive play requires a host game binary built on this engine.

[meta]
name        = 21-stairs-spiral
title       = Spiral Staircase Demo

[room]
size        = 12 12 13
ambient     = solid
storey_height = 8

[material walls]
fg          = #A0A8B8
bg          = #0E1220
recipe      = circuit grain=0.3
surface     = wall_solid

[material ground]
preset      = metal
surface     = floor

[material roof]
preset      = void
surface     = ceiling

# ── Dense [cells] grid ────────────────────────────────────────────────────────
# 12 cols (x=0..11) × 12 rows (y=0..11) × 13 z-layers.
# '#' = WallSolid   '.' = Empty   '_' = Floor   '^' = Ceiling
#
# Spiral cells (WallSolid '#') at each layer, in addition to perimeter walls:
#   z=0:  floor slab; (5,5)='#' (tread1), (6,6)='#' (column)
#   z=1:  (6,5)='#' (tread2), (6,6)='#' (column)
#   z=2:  (7,5)='#' (tread3), (6,6)='#' (column)
#   z=3:  (7,6)='#' (tread4), (6,6)='#' (column)
#   z=4:  (7,7)='#' (tread5), (6,6)='#' (column)
#   z=5:  (6,7)='#' (tread6), (6,6)='#' (column)
#   z=6:  (5,7)='#' (tread7), (6,6)='#' (column)
#   z=7:  (5,6)='#' (tread8), (6,6)='#' (column)
#   z=8:  floor-1 slab; (5,5)='#' (landing), (6,6)='#' (column top)
#   z=9..11: floor-1 gameplay space (perimeter walls only, interior '.')
#   z=12: ceiling slab
[cells]
size        = 12 12 13

# z=0 — floor-0 slab. Floor '_' everywhere interior.
