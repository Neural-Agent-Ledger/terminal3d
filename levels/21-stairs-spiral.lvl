# Staircase geometry: ramp directions for each spiral tread.
# Matches spiral_staircase(center=(6,6,0), radius=1, turns=1, storey_height=8).
shapes =
5 5 0 rampz posx
6 5 1 rampz posx
7 5 2 rampz posy
7 6 3 rampz posy
7 7 4 rampz negx
6 7 5 rampz negx
5 7 6 rampz negy
5 6 7 rampz negy

# ── Minimal puzzle so this is a real level ────────────────────────────────────
# Output node on floor 1 — the reward for climbing the spiral staircase.

[node a]
pos         = 2 6 9
glyph       = A
is_input    = yes

[node b]
pos         = 9 6 9
glyph       = B
is_output   = yes
threshold   = 1

[pipe a->b]
state       = ON
path        = (2,6,9) (9,6,9)

[part block]
size        = 1 1 1
mask        =
#
color       = #60D0A0

[emit b=1]
parts       = block

[inputs]
a           = 1

[pedestal]
center      = 8 6 8
volume      = 1 1 1

[door]
pos         = 10 6 8
target_parts = b

# Spawn on floor 0, facing +x (east, toward the spiral staircase).
[player]
spawn       = 2 6 1
facing      = +x
